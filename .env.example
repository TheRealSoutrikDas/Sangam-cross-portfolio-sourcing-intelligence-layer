# Live extraction and negotiation drafting. Without this the graph runs the
# cached extraction path and skips the drafting tail, which is the default
# and is how the demo is meant to be reviewed.
GOOGLE_API_KEY=

# Optional. Model names get retired: gemini-2.5-* stopped accepting new keys
# in mid-2026. This is an env var precisely so a retirement is a config change,
# not a code change. Check what your key can see:
#   python -c "from google import genai; c=genai.Client(); [print(m.name) for m in c.models.list()]"
SANGAM_MODEL=gemini-3.5-flash

# Force the golden replay even when a key is present. Used in CI so that
# extraction changes cannot silently alter regression results.
# SANGAM_FORCE_CACHED=1

# Free-tier Gemini allows a handful of requests per minute and this pipeline
# makes several (the extraction repair loop alone can burn three). Model-backed
# nodes retry a 429 with exponential backoff. Raise the delay if you are on a
# tighter quota; a paid key rarely needs either of these.
# SANGAM_RETRY_ATTEMPTS=5
# SANGAM_RETRY_DELAY=20
